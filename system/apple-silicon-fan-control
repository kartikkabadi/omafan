#!/usr/bin/python3 -I
"""Root-owned persistent fan settings with independently supervised recovery.

Only status is available without root. Production paths are fixed: environment
variables and command-line arguments cannot redirect privileged filesystem I/O.
"""
import contextlib
import fcntl
import json
import math
import os
from pathlib import Path
import re
import signal
import socket
import stat
import subprocess
import sys
import time
import uuid

RUNTIME = Path('/run/apple-silicon-fan-control')
SYSFS = Path('/sys')
PERSISTENCE = Path('/var/lib/apple-silicon-fan-control')
RETRY_SECONDS = 30.0
DRIFT_COOLDOWN_SECONDS = 60.0
WATCHDOG_INTERVAL = 2.0
WATCHDOG_MAX_AGE = 6.0
MAX_JSON = 65536
MAX_DRIFT_REPAIRS = 2
DRIFT_REPAIR_WINDOW = 30.0
TARGET_SETTLE_SECONDS = 0.15


def clock():
    return time.clock_gettime(time.CLOCK_BOOTTIME)


def boot_id():
    return Path('/proc/sys/kernel/random/boot_id').read_text().strip()


def secure_regular(path, writable=False):
    flags = (os.O_RDWR if writable else os.O_RDONLY) | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK
    fd = os.open(path, flags)
    info = os.fstat(fd)
    if info.st_uid != 0 or not stat.S_ISREG(info.st_mode) or info.st_mode & 0o022:
        os.close(fd)
        raise RuntimeError('Insecure root-owned file: ' + str(path))
    return fd


def read_json(path):
    fd = secure_regular(path)
    with os.fdopen(fd, 'r') as stream:
        data = stream.read(MAX_JSON + 1)
    if len(data) > MAX_JSON:
        raise RuntimeError('Oversized broker state')
    depth = 0
    quoted = False
    escaped = False
    for character in data:
        if quoted:
            if escaped:
                escaped = False
            elif character == '\\':
                escaped = True
            elif character == '"':
                quoted = False
        elif character == '"':
            quoted = True
        elif character in '{[':
            depth += 1
            if depth > 16:
                raise RuntimeError('Invalid broker JSON: excessive nesting')
        elif character in '}]':
            depth -= 1
    def unique_object(pairs):
        value = {}
        for key, item in pairs:
            if key in value:
                raise ValueError('Duplicate JSON field: ' + str(key))
            value[key] = item
        return value
    try:
        value = json.loads(data, object_pairs_hook=unique_object)
    except (ValueError, RecursionError) as exc:
        raise RuntimeError('Invalid broker JSON: ' + str(exc)) from exc
    if not isinstance(value, dict):
        raise RuntimeError('Invalid broker state')
    return value


def atomic_json(path, data):
    temp = path.with_name('.' + path.name + '.' + uuid.uuid4().hex)
    fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
    try:
        with os.fdopen(fd, 'w') as stream:
            json.dump(data, stream, allow_nan=False, separators=(',', ':'))
            stream.write('\n')
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temp, path)
        directory_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        with contextlib.suppress(FileNotFoundError):
            temp.unlink()


def secure_runtime(create=False):
    if create:
        RUNTIME.mkdir(mode=0o755, exist_ok=True)
    info = RUNTIME.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise RuntimeError('Insecure broker runtime directory')


@contextlib.contextmanager
def locked():
    secure_runtime(create=True)
    path = RUNTIME / 'lock'
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK, 0o600)
    try:
        info = os.fstat(fd)
        if info.st_uid != 0 or not stat.S_ISREG(info.st_mode) or info.st_mode & 0o077:
            raise RuntimeError('Insecure broker lock')
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


class ThermalFault(RuntimeError):
    """A missing, invalid or excessive temperature requires a cooling pause."""


class Hardware:
    def __init__(self):
        self.root = SYSFS.resolve(strict=True)
        matches = []
        for entry in (self.root / 'class/hwmon').glob('hwmon*'):
            try:
                name = (entry / 'name').read_text().strip()
            except OSError:
                continue
            if name == 'macsmc_hwmon':
                resolved = entry.resolve(strict=True)
                if not resolved.is_relative_to(self.root / 'devices'):
                    raise RuntimeError('Unexpected macsmc_hwmon path')
                matches.append(resolved)
        if len(matches) != 1:
            raise RuntimeError('Expected exactly one macsmc_hwmon device')
        self.directory = matches[0]
        self.fans = []
        for path in sorted(self.directory.glob('fan*_target')):
            match = re.fullmatch(r'fan([1-9][0-9]*)_target', path.name)
            if not match:
                continue
            resolved = path.resolve(strict=True)
            if resolved.parent != self.directory:
                raise RuntimeError('Fan register escapes hwmon directory')
            self.fans.append((int(match[1]), resolved))
        if not self.fans:
            raise RuntimeError('No controllable fans found')

    def bounds(self, path):
        stem = path.name.removesuffix('_target')
        values = []
        for suffix in ('_min', '_max'):
            raw = (path.parent / (stem + suffix)).read_text().strip()
            if not re.fullmatch(r'[0-9]{1,5}', raw):
                raise RuntimeError('Invalid hardware fan limits')
            values.append(int(raw))
        minimum, maximum = values
        if not 100 <= minimum <= maximum <= 50000:
            raise RuntimeError('Invalid hardware fan range')
        return minimum, maximum

    def enable(self):
        path = self.root / 'module/macsmc_hwmon/parameters/fan_control'
        fd = secure_regular(path)
        with os.fdopen(fd, 'r') as stream:
            current = stream.read(16).strip()
        if current in ('Y', '1'):
            return
        fd = secure_regular(path, writable=True)
        with os.fdopen(fd, 'w') as stream:
            stream.write('1\n')

    def write(self, path, value):
        # Runtime enabling does not update hwmon's registration-time file mode.
        # Change only the canonical root-owned register, never a user path.
        fd = secure_regular(path)
        try:
            os.fchmod(fd, 0o644)
        finally:
            os.close(fd)
        fd = secure_regular(path, writable=True)
        with os.fdopen(fd, 'w') as stream:
            stream.write(str(value) + '\n')

    def automatic(self):
        errors = []
        try:
            self.enable()
        except (OSError, RuntimeError) as exc:
            errors.append('fan control enable: ' + str(exc))
        for index, path in self.fans:
            # A nonzero write first forces the driver's cached mode into manual,
            # so zero subsequently writes the SMC mode even after resume.
            # Maximum is deliberately used for the short recovery transition.
            try:
                _, maximum = self.bounds(path)
                self.write(path, maximum)
            except (OSError, RuntimeError) as exc:
                errors.append('fan%d prime: %s' % (index, exc))
            try:
                self.write(path, 0)
            except (OSError, RuntimeError) as exc:
                errors.append('fan%d auto: %s' % (index, exc))
        if errors:
            raise RuntimeError('; '.join(errors))

    def planned_targets(self, rpm=None, fans=None):
        # All fan channels must be controllable. Individual maps are matched by
        # stable hwmon index, never by array position or a shifted channel list.
        inputs = {int(re.fullmatch(r'fan([1-9][0-9]*)_input', p.name)[1])
                  for p in self.directory.glob('fan*_input')
                  if re.fullmatch(r'fan([1-9][0-9]*)_input', p.name)}
        indices = {index for index, _ in self.fans}
        if inputs != indices:
            raise RuntimeError('Some fans have no controllable target')
        if len(indices) > 32 or any(not 1 <= index <= 64 for index in indices):
            raise RuntimeError('Fan inventory is outside the supported manual-control range')
        individual = None
        if fans is not None:
            individual = {item['index']: item['rpm'] for item in validate_fans(fans)}
            if set(individual) != indices:
                raise RuntimeError('Saved fan inventory does not match this hardware; select Auto, then configure the available fans again')
        targets = []
        for index, path in self.fans:
            minimum, maximum = self.bounds(path)
            requested = individual[index] if individual is not None else rpm
            if type(requested) is not int or not 1000 <= requested <= 7999:
                raise RuntimeError('Invalid manual fan RPM')
            targets.append({'index': index, 'target': min(maximum, max(minimum, requested))})
        return targets

    def manual(self, rpm):
        targets = self.planned_targets(rpm=rpm)
        self.reacquire(targets)
        return targets

    def manual_individual(self, fans, previous_targets=None):
        targets = self.planned_targets(fans=fans)
        changed_indices = None
        if previous_targets is not None and self.matches(previous_targets):
            old = {item['index']: item['target'] for item in previous_targets}
            if set(old) == {item['index'] for item in targets}:
                changed_indices = {item['index'] for item in targets if old[item['index']] != item['target']}
        self.reacquire(targets, changed_indices=changed_indices)
        return targets

    def seed_linked(self, preference):
        # This fallback is used only before the first Linked setting is saved.
        # Never lower a currently applied/planned channel merely to enter it.
        self.planned_targets(rpm=1000)
        observed = {item['index']: item['target'] for item in self.observed_targets()}
        values = []
        for index, path in self.fans:
            minimum, maximum = self.bounds(path)
            values.append(min(maximum, max(minimum, observed[index])))
        applicable_plan = (preference['control_mode'] != 'individual'
                           or {item['index'] for item in preference['fans']} == {index for index, _ in self.fans})
        if preference['mode'] == 'manual' and applicable_plan:
            planned = (self.planned_targets(fans=preference['fans'])
                       if preference['control_mode'] == 'individual'
                       else self.planned_targets(rpm=preference['rpm']))
            values.extend(item['target'] for item in planned)
        maximum = max(values)
        candidate = max(1000, maximum)
        if candidate > 7999:
            raise RuntimeError('Current fan targets cannot be represented safely by Linked; choose an explicit shared RPM first')
        self.planned_targets(rpm=candidate)
        return candidate

    def seed_separate(self):
        # With no remembered profile, snapshot the currently applied setpoints.
        # Inventory, bounds and representability are validated before writes.
        self.planned_targets(rpm=1000)
        observed = {item['index']: item['target'] for item in self.observed_targets()}
        fans = []
        for index, path in self.fans:
            minimum, maximum = self.bounds(path)
            value = min(maximum, max(minimum, observed[index]))
            candidate = min(7999, max(1000, value))
            if min(maximum, max(minimum, candidate)) != value:
                raise RuntimeError('A current fan target cannot be represented safely; configure fan speeds explicitly first')
            fans.append({'index': index, 'rpm': candidate})
        return sorted(fans, key=lambda item: item['index'])

    def seed_individual(self, preference, changed_index, changed_rpm):
        indices = {index for index, _ in self.fans}
        if changed_index not in indices:
            raise RuntimeError('Requested fan index does not exist on this hardware')
        if preference['mode'] == 'manual' and preference['control_mode'] == 'individual':
            # Exact inventory is intentional: never drop a missing fan or give
            # a newly appeared channel someone else's saved target.
            self.planned_targets(fans=preference['fans'])
            desired = {item['index']: item['rpm'] for item in preference['fans']}
        else:
            if preference['mode'] == 'manual':
                values = self.planned_targets(rpm=preference['rpm'])
            else:
                # An explicit first individual edit freezes the other channels
                # at their current firmware setpoints, bounded by their limits.
                self.planned_targets(rpm=1000)
                values = self.observed_targets()
            observed = {item['index']: item['target'] for item in values}
            desired = {}
            for index, path in self.fans:
                if index == changed_index:
                    desired[index] = changed_rpm
                    continue
                minimum, maximum = self.bounds(path)
                value = min(maximum, max(minimum, observed[index]))
                candidate = min(7999, max(1000, value))
                if min(maximum, max(minimum, candidate)) != value:
                    raise RuntimeError('An unchanged fan target cannot be represented safely; use the shared RPM command before individual configuration')
                desired[index] = candidate
        desired[changed_index] = changed_rpm
        return [{'index': index, 'rpm': desired[index]} for index in sorted(desired)]

    def check_temperatures(self, limit=80000):
        sensors = list(self.directory.glob('temp*_input'))
        if not sensors:
            raise ThermalFault('Temperature monitoring unavailable')
        for path in sensors:
            raw = path.read_text().strip()
            if not re.fullmatch(r'-?[0-9]{1,7}', raw) or not -40000 <= int(raw) < limit:
                raise ThermalFault('Temperature invalid or at/above %g C; manual setting paused' % (limit / 1000))

    def observed_targets(self):
        return [{'index': index, 'target': int(path.read_text().strip())}
                for index, path in self.fans]

    @staticmethod
    def target_diagnostic(requested, observed):
        def describe(values):
            return ', '.join('fan%d=%d' % (item['index'], item['target']) for item in values)
        return 'requested [' + describe(requested) + '] RPM; observed [' + describe(observed) + '] RPM'

    def matches(self, targets, observed=None):
        if observed is None:
            observed = self.observed_targets()
        values = {item['index']: item['target'] for item in observed}
        return (set(values) == {item['index'] for item in targets}
                and all(abs(values[item['index']] - item['target']) <= 10 for item in targets))

    def reacquire(self, targets, changed_indices=None):
        requested = {item['index']: item['target'] for item in targets}
        if set(requested) != {index for index, _ in self.fans}:
            raise RuntimeError('Fan inventory changed during manual control')
        # A stale cached manual=true flag otherwise prevents the driver from
        # writing mode=1 again. Zero first forces its next valid target to set
        # manual mode in hardware. Validate all targets before touching any fan.
        for index, path in self.fans:
            minimum, maximum = self.bounds(path)
            if not minimum <= requested[index] <= maximum:
                raise RuntimeError('Hardware fan limits changed during manual control')
        self.check_temperatures()
        selected = set(requested) if changed_indices is None else changed_indices
        if not selected.issubset(requested):
            raise RuntimeError('Invalid incremental fan update')
        if selected:
            self.enable()
            for index, path in self.fans:
                if index in selected:
                    self.write(path, 0)
                    self.write(path, requested[index])
            time.sleep(TARGET_SETTLE_SECONDS)
        observed = self.observed_targets()
        if not self.matches(targets, observed):
            raise RuntimeError('Manual target did not hold: ' + self.target_diagnostic(targets, observed))


def validate_fans(fans, allow_empty=False):
    if not isinstance(fans, list) or len(fans) > 64 or (not fans and not allow_empty):
        raise RuntimeError('Invalid saved per-fan target list')
    seen = set()
    result = []
    for item in fans:
        if (not isinstance(item, dict) or set(item) != {'index', 'rpm'}
                or type(item['index']) is not int or not 1 <= item['index'] <= 64
                or item['index'] in seen or type(item['rpm']) is not int
                or not 1000 <= item['rpm'] <= 7999):
            raise RuntimeError('Invalid or duplicate saved per-fan target')
        seen.add(item['index'])
        result.append({'index': item['index'], 'rpm': item['rpm']})
    return sorted(result, key=lambda item: item['index'])


def preference_default():
    return {'schema_version': 4, 'mode': 'auto', 'control_mode': 'auto',
            'rpm': None, 'fans': [], 'separate_fans': [], 'linked_rpm': None,
            'owner_uid': None, 'generation': '0' * 32}


def validate_preference(value):
    old_fields = {'schema_version', 'mode', 'rpm', 'owner_uid', 'generation'}
    second_fields = old_fields | {'control_mode', 'fans'}
    third_fields = second_fields | {'separate_fans'}
    current_fields = third_fields | {'linked_rpm'}
    if not isinstance(value, dict) or type(value.get('schema_version')) is not int:
        raise RuntimeError('Invalid saved fan preference schema')
    version = value['schema_version']
    if version == 1 and set(value) == old_fields:
        value = {**value, 'schema_version': 2,
                 'control_mode': 'shared' if value['mode'] == 'manual' else 'auto', 'fans': []}
        version = 2
    if version == 2 and set(value) == second_fields:
        # Migration is read-only until an explicit user setting is saved. A
        # previously active individual map is also the remembered profile.
        memory = value['fans'] if value['mode'] == 'manual' and value['control_mode'] == 'individual' else []
        value = {**value, 'schema_version': 3, 'separate_fans': memory}
        version = 3
    if version == 3 and set(value) == third_fields:
        linked = value['rpm'] if value['mode'] == 'manual' and value['control_mode'] == 'shared' else None
        value = {**value, 'schema_version': 4, 'linked_rpm': linked}
    elif version != 4 or set(value) != current_fields:
        raise RuntimeError('Invalid saved fan preference schema')
    if (value['mode'] not in ('auto', 'manual')
            or not isinstance(value['generation'], str)
            or not re.fullmatch(r'[0-9a-f]{32}', value['generation'])):
        raise RuntimeError('Invalid saved fan preference schema')
    if value['linked_rpm'] is not None and (type(value['linked_rpm']) is not int or not 1000 <= value['linked_rpm'] <= 7999):
        raise RuntimeError('Invalid remembered Linked RPM')
    value = {**value, 'separate_fans': validate_fans(value['separate_fans'], allow_empty=True)}
    if value['mode'] == 'auto':
        if (value['control_mode'] != 'auto' or value['rpm'] is not None
                or value['owner_uid'] is not None or value['fans'] != []):
            raise RuntimeError('Automatic preference must not contain an active manual target')
    else:
        if type(value['owner_uid']) is not int or not 0 <= value['owner_uid'] <= 4294967295:
            raise RuntimeError('Invalid saved manual owner')
        if value['control_mode'] == 'shared':
            if type(value['rpm']) is not int or not 1000 <= value['rpm'] <= 7999 or value['fans'] != []:
                raise RuntimeError('Invalid saved shared RPM')
            if value['linked_rpm'] != value['rpm']:
                raise RuntimeError('Active Shared RPM must match the remembered Linked RPM')
        elif value['control_mode'] == 'individual':
            if value['rpm'] is not None:
                raise RuntimeError('Individual preference must not contain a shared RPM')
            value = {**value, 'fans': validate_fans(value['fans'])}
            if value['fans'] != value['separate_fans']:
                raise RuntimeError('Active individual targets must match the remembered separate profile')
        else:
            raise RuntimeError('Invalid saved control mode')
    return dict(value)


def secure_persistence(create=False):
    if create:
        PERSISTENCE.mkdir(mode=0o755, exist_ok=True)
    info = PERSISTENCE.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise RuntimeError('Insecure saved-preference directory')


def load_preference():
    try:
        secure_persistence()
        return validate_preference(read_json(PERSISTENCE / 'preference.json')), None
    except FileNotFoundError:
        return preference_default(), None
    except (OSError, ValueError, KeyError, TypeError, RuntimeError) as exc:
        return preference_default(), 'Saved fan preference is invalid: ' + str(exc)


def save_preference(preference):
    preference = validate_preference(preference)
    secure_persistence(create=True)
    path = PERSISTENCE / 'preference.json'
    # Explicit user changes may replace malformed JSON, but never bypass an
    # insecure directory, symlink or writable/non-root-owned file.
    if path.exists() or path.is_symlink():
        fd = secure_regular(path)
        os.close(fd)
    atomic_json(path, preference)


def sleep_operation_finished():
    # Post hooks also run at intermediate RTC wakes. A failed pre unit may
    # signal while sleep.target is still inactive but has a queued start job.
    try:
        result = subprocess.run(
            ['/usr/bin/systemctl', '--system', '--no-pager', '--no-ask-password',
             'show', 'sleep.target', '--all', '--property=ActiveState', '--property=Job'],
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            text=True, timeout=1,
            env={'PATH': '/usr/bin:/bin', 'LANG': 'C', 'LC_ALL': 'C',
                 'SYSTEMD_COLORS': '0', 'SYSTEMD_PAGER': ''})
        if result.returncode != 0:
            return False
        properties = {}
        for line in result.stdout.strip().splitlines():
            key, separator, value = line.partition('=')
            if separator != '=' or key not in ('ActiveState', 'Job') or key in properties:
                return False
            properties[key] = value
        return (set(properties) == {'ActiveState', 'Job'}
                and properties['ActiveState'] in ('inactive', 'failed')
                and properties['Job'] == '')
    except (OSError, subprocess.TimeoutExpired):
        return False


def signal_wake():
    # The post-wake hook runs while user.slice is still frozen. It must never
    # wait for the operation lock, which a frozen sudo process might hold.
    secure_runtime(create=True)
    atomic_json(RUNTIME / 'wake.json', {'schema_version': 1, 'boot_id': boot_id(),
                'generation': uuid.uuid4().hex, 'created_at': clock()})


def load_wake():
    try:
        event = read_json(RUNTIME / 'wake.json')
        if (set(event) != {'schema_version', 'boot_id', 'generation', 'created_at'}
                or type(event['schema_version']) is not int or event['schema_version'] != 1
                or not isinstance(event['boot_id'], str)
                or not isinstance(event['generation'], str)
                or not re.fullmatch(r'[0-9a-f]{32}', event['generation'])
                or type(event['created_at']) not in (int, float)
                or not math.isfinite(event['created_at']) or event['created_at'] < 0):
            raise RuntimeError('Invalid wake notification fields')
        if event['boot_id'] != boot_id():
            return None, None
        if event['created_at'] > clock():
            # Return the otherwise valid generation so reconciliation can retire
            # it permanently, rather than accepting it when time catches up.
            return event, 'Wake notification invalid: notification is from the future'
        return event, None
    except FileNotFoundError:
        return None, None
    except (OSError, ValueError, KeyError, TypeError, RuntimeError) as exc:
        return None, 'Wake notification invalid: ' + str(exc)


def state_default(error=None):
    return {'schema_version': 1, 'mode': 'unknown', 'owner_uid': None,
            'expires_at': 0, 'boot_id': boot_id(), 'generation': uuid.uuid4().hex,
            'targets': [], 'inhibited': False, 'error': error, 'repairs': [],
            'recovering': False, 'requested_rpm': None, 'requested_fans': [], 'control_mode': 'auto', 'retry_at': 0,
            'thermal_paused': False, 'restore_blocked_generation': None, 'restore_blocked_reason': None,
            'wake_generation': None, 'sleep_started_at': 0}


def load_state():
    try:
        state = read_json(RUNTIME / 'state.json')
        if state.get('boot_id') != boot_id():
            return state_default('Broker state belongs to another boot')
        mode = state.get('mode')
        expiry = state.get('expires_at')
        owner = state.get('owner_uid')
        targets = state.get('targets')
        repairs = state.setdefault('repairs', [])
        recovering = state.setdefault('recovering', False)
        requested = state.setdefault('requested_rpm', None)
        requested_fans = state.setdefault('requested_fans', [])
        control_mode = state.setdefault('control_mode', 'shared' if mode == 'manual' else 'auto')
        if control_mode not in ('auto', 'shared', 'individual') or validate_fans(requested_fans, allow_empty=True) != requested_fans:
            raise RuntimeError('Invalid runtime per-fan control state')
        if control_mode == 'individual' and (requested is not None or not requested_fans):
            raise RuntimeError('Incomplete individual runtime targets')
        if control_mode != 'individual' and requested_fans:
            raise RuntimeError('Unexpected individual runtime targets')
        retry_at = state.setdefault('retry_at', 0)
        thermal_paused = state.setdefault('thermal_paused', False)
        blocked_generation = state.setdefault('restore_blocked_generation', None)
        blocked_reason = state.setdefault('restore_blocked_reason', None)
        wake_generation = state.setdefault('wake_generation', None)
        sleep_started_at = state.setdefault('sleep_started_at', 0)
        if (type(state.get('schema_version')) is not int or state['schema_version'] != 1 or mode not in ('auto', 'manual', 'unknown')
                or type(expiry) not in (int, float) or not math.isfinite(expiry) or expiry < 0
                or (owner is not None and (type(owner) is not int or owner < 0))
                or not re.fullmatch(r'[0-9a-f]{32}', str(state.get('generation', '')))
                or type(state.get('inhibited')) is not bool or type(recovering) is not bool
                or type(thermal_paused) is not bool
                or (wake_generation is not None and (not isinstance(wake_generation, str) or not re.fullmatch(r'[0-9a-f]{32}', wake_generation)))
                or type(sleep_started_at) not in (int, float) or not math.isfinite(sleep_started_at) or sleep_started_at < 0
                or (blocked_generation is not None and (not isinstance(blocked_generation, str) or not re.fullmatch(r'[0-9a-f]{32}', blocked_generation)))
                or (blocked_reason is not None and not isinstance(blocked_reason, str))
                or type(retry_at) not in (int, float) or not math.isfinite(retry_at) or retry_at < 0
                or (requested is not None and (type(requested) is not int or not 1000 <= requested <= 7999))
                or not isinstance(targets, list) or len(targets) > 64
                or not isinstance(repairs, list) or len(repairs) > MAX_DRIFT_REPAIRS
                or any(type(value) not in (int, float) or not math.isfinite(value) or value < 0 for value in repairs)
                or (state.get('error') is not None and not isinstance(state.get('error'), str))):
            raise RuntimeError('Invalid broker state fields')
        indices = set()
        for target in targets:
            if (not isinstance(target, dict) or type(target.get('index')) is not int
                    or not 1 <= target['index'] <= 64 or target['index'] in indices
                    or type(target.get('target')) is not int or not 100 <= target['target'] <= 50000):
                raise RuntimeError('Invalid broker target state')
            indices.add(target['index'])
        if mode == 'manual' and (owner is None or not targets):
            raise RuntimeError('Incomplete manual controller state')
        return state
    except (OSError, ValueError, KeyError, TypeError, RuntimeError):
        return state_default('No valid broker state')


def watchdog_ready():
    try:
        health = read_json(RUNTIME / 'watchdog.json')
        updated = health.get('updated_at')
        if type(updated) not in (int, float) or not math.isfinite(updated) or updated < 0:
            return False
        elapsed = clock() - updated
        return health.get('boot_id') == boot_id() and 0 <= elapsed <= WATCHDOG_MAX_AGE
    except (OSError, ValueError, KeyError, TypeError, RuntimeError):
        return False


def status():
    preference, preference_error = load_preference()
    saved = {'persistent': True, 'per_fan_control': True, 'separate_memory': True, 'linked_memory': True,
             'saved_linked_rpm': preference['linked_rpm'],
             'saved_separate_fans': preference['separate_fans'], 'saved_mode': preference['mode'],
             'saved_control_mode': preference['control_mode'], 'saved_fans': preference['fans'],
             'requested_fans': preference['fans'],
             'saved_rpm': preference['rpm'], 'saved_owner_uid': preference['owner_uid'],
             'preference_error': preference_error, 'requested_rpm': preference['rpm']}
    try:
        secure_runtime()
        state = load_state()
        ready = watchdog_ready()
        mode = state['mode'] if ready else 'unknown'
        error = (preference_error or state.get('error')) if ready else 'Fan watchdog is not running'
        notice = None
        if mode == 'manual' and error and error.startswith('Recovered manual target drift:'):
            notice, error = error, None
        pause_reason = ('Paused for sleep' if state['inhibited'] else state.get('error')) if preference['mode'] == 'manual' and mode != 'manual' else None
        return {**state, **saved, 'mode': mode, 'paused_reason': pause_reason,
                'ready': ready and mode != 'unknown' and not state['inhibited'],
                'expires_in': 0, 'retry_in': round(max(0, state['retry_at'] - clock()), 1),
                'error': error, 'notice': notice}
    except (OSError, ValueError, TypeError, RuntimeError):
        return {**state_default('Fan control is not configured'), **saved,
                'ready': False, 'expires_in': 0, 'retry_in': 0, 'notice': None}


def save(state):
    atomic_json(RUNTIME / 'state.json', state)


def reset(reason=None, retry_delay=0, thermal_paused=False, clear_block=False):
    previous = load_state()
    inhibited = previous.get('inhibited', False)
    state = state_default()
    state.update(inhibited=inhibited, retry_at=clock() + retry_delay if retry_delay else 0,
                 thermal_paused=thermal_paused, wake_generation=previous.get('wake_generation'),
                 sleep_started_at=previous.get('sleep_started_at', 0))
    if not clear_block:
        state['restore_blocked_generation'] = previous.get('restore_blocked_generation')
        state['restore_blocked_reason'] = previous.get('restore_blocked_reason')
    # All physical transitions are journaled independently from durable intent.
    try:
        save(state)
    except OSError as exc:
        print('Cannot journal automatic recovery: ' + str(exc), file=sys.stderr)
    try:
        Hardware().automatic()
        state['mode'] = 'auto'
        state['error'] = reason
    except (OSError, ValueError, RuntimeError) as exc:
        state['error'] = 'Could not restore automatic cooling: ' + str(exc)
        state['retry_at'] = clock() + RETRY_SECONDS
    save(state)
    return state['mode'] == 'auto'


def owner_uid():
    value = os.environ.get('SUDO_UID', '0')
    if not re.fullmatch(r'[0-9]{1,10}', value):
        raise RuntimeError('Invalid calling user')
    return int(value)


def state_matches_preference(state, preference):
    return (state['generation'] == preference['generation']
            and state['owner_uid'] == preference['owner_uid']
            and state['requested_rpm'] == preference['rpm']
            and state['control_mode'] == preference['control_mode']
            and state['requested_fans'] == preference['fans'])


def apply_manual(preference, persist=False):
    preference = validate_preference(preference)
    previous = load_state()
    prior_preference, prior_error = load_preference()
    previous_targets = None
    if (persist and preference['control_mode'] == 'individual' and prior_error is None
            and previous['mode'] == 'manual' and state_matches_preference(previous, prior_preference)):
        previous_targets = previous['targets']
    state = state_default('Applying saved manual target')
    if persist:
        state['restore_blocked_generation'] = previous.get('restore_blocked_generation')
        state['restore_blocked_reason'] = previous.get('restore_blocked_reason')
    state.update(wake_generation=previous.get('wake_generation'),
                 sleep_started_at=previous.get('sleep_started_at', 0),
                 owner_uid=preference['owner_uid'], generation=preference['generation'],
                 requested_rpm=preference['rpm'], requested_fans=preference['fans'],
                 control_mode=preference['control_mode'], recovering=True)
    save(state)
    committed = False
    try:
        hardware = Hardware()
        targets = (hardware.manual_individual(preference['fans'], previous_targets=previous_targets)
                   if preference['control_mode'] == 'individual' else hardware.manual(preference['rpm']))
        hardware.check_temperatures()
        if persist:
            save_preference(preference)
            committed = True
        state.update(mode='manual', targets=targets, recovering=False, error=None,
                     restore_blocked_generation=None, restore_blocked_reason=None)
        save(state)
    except (OSError, ValueError, RuntimeError) as exc:
        reset('Manual target paused: ' + str(exc), retry_delay=RETRY_SECONDS,
              thermal_paused=isinstance(exc, ThermalFault))
        saved_now, saved_error = load_preference()
        if committed or (saved_error is None and saved_now['generation'] == preference['generation']):
            intent_note = 'the new target is saved but its application or durability needs recovery'
        else:
            intent_note = 'the prior saved intent is retained'
        raise RuntimeError('Manual control failed; automatic recovery attempted; ' + intent_note + ': ' + str(exc)) from exc


def command(action, generation=None, fan_index=None, fan_rpm=None):
    if action in ('wake-signal', 'sleep-failed'):
        failed = bool(os.environ.get('SERVICE_RESULT')) and os.environ['SERVICE_RESULT'] != 'success'
        if action == 'wake-signal' or failed:
            signal_wake()
            return True
        return False
    with locked():
        if action in ('sleep', 'resume'):
            state = load_state()
            event, event_error = load_wake()
            if action == 'resume' and event_error:
                # An explicit administrative resume may repair damaged wake
                # metadata. Public sudoers actions cannot invoke this path.
                signal_wake()
                event, event_error = load_wake()
            if (action == 'resume' and event is not None
                    and event['generation'] == state['wake_generation']
                    and not state['inhibited'] and state['mode'] in ('auto', 'manual')):
                return  # The post-wake event already performed recovery.
            state['inhibited'] = action == 'sleep'
            state['sleep_started_at'] = clock() if action == 'sleep' else 0
            if event is not None:
                # Retire old notifications before a new sleep. They must never
                # clear an inhibit belonging to a later sleep attempt.
                state['wake_generation'] = event['generation']
            save(state)
            if not reset('Manual setting paused for sleep' if action == 'sleep' else None):
                raise RuntimeError(load_state()['error'])
            return
        if action in ('auto', 'release'):
            preference_failure = None
            if action == 'auto':
                # Commit explicit Auto intent first: a crash after release must
                # never resurrect the previously selected manual preference.
                try:
                    previous_preference, previous_error = load_preference()
                    preference = preference_default()
                    if previous_error is None:
                        preference['separate_fans'] = previous_preference['separate_fans']
                        preference['linked_rpm'] = previous_preference['linked_rpm']
                    preference['generation'] = uuid.uuid4().hex
                    save_preference(preference)
                except (OSError, ValueError, RuntimeError) as exc:
                    preference_failure = exc
            reason = None
            if preference_failure is not None:
                previous_preference, previous_error = load_preference()
                current = load_state()
                reason = 'Auto was requested but could not be saved: ' + str(preference_failure)
                current.update(error=reason, restore_blocked_reason=reason,
                               restore_blocked_generation=previous_preference['generation'] if previous_error is None and previous_preference['mode'] == 'manual' else None)
                # Journal the restore block before physical release as well. A
                # killed Auto command must not reopen the old manual preference.
                try:
                    save(current)
                except OSError as exc:
                    print('Cannot journal restore block: ' + str(exc), file=sys.stderr)
            restored = reset(reason, clear_block=action == 'auto' and preference_failure is None)
            if preference_failure is not None:
                raise RuntimeError('Automatic cooling release attempted, but Auto could not be saved: ' + str(preference_failure))
            if not restored:
                raise RuntimeError(load_state()['error'])
            return
        _, wake_error = load_wake()
        if wake_error:
            raise RuntimeError(wake_error)
        if not watchdog_ready():
            raise RuntimeError('Fan watchdog is not running; manual control refused')
        uid = owner_uid()
        state = load_state()
        if state['inhibited']:
            raise RuntimeError('Fan control is inhibited for sleep or failed resume recovery')
        if state['mode'] not in ('auto', 'manual'):
            raise RuntimeError('Automatic cooling has not been established; manual control refused')
        if action == 'heartbeat':
            # Compatibility with older widgets. The root daemon now owns the
            # saved manual setting; UI liveness no longer controls its lifetime.
            if state['mode'] != 'manual' or state['owner_uid'] != uid or generation != state['generation']:
                raise RuntimeError('No active manual setting belongs to this user/generation')
            return
        if state['mode'] == 'manual' and state['owner_uid'] != uid:
            raise RuntimeError('Another user owns the manual setting; select Auto first')
        previous_preference, _ = load_preference()
        if action == 'linked':
            hardware = Hardware()
            linked = previous_preference['linked_rpm']
            if linked is None:
                linked = hardware.seed_linked(previous_preference)
            hardware.planned_targets(rpm=linked)
            preference = {'schema_version': 4, 'mode': 'manual', 'control_mode': 'shared',
                          'rpm': linked, 'fans': [], 'separate_fans': previous_preference['separate_fans'],
                          'linked_rpm': linked, 'owner_uid': uid, 'generation': uuid.uuid4().hex}
        elif action == 'separate':
            hardware = Hardware()
            fans = previous_preference['separate_fans']
            if fans:
                # Inactive inventory does not affect Shared/Auto. Check it only
                # when the user explicitly asks to restore the remembered map.
                try:
                    hardware.planned_targets(fans=fans)
                except RuntimeError as exc:
                    raise RuntimeError('Remembered separate profile cannot be restored: ' + str(exc)) from exc
            else:
                fans = hardware.seed_separate()
            preference = {'schema_version': 4, 'mode': 'manual', 'control_mode': 'individual',
                          'rpm': None, 'fans': fans, 'separate_fans': fans,
                          'linked_rpm': previous_preference['linked_rpm'],
                          'owner_uid': uid, 'generation': uuid.uuid4().hex}
        elif action == 'fan':
            if type(fan_index) is not int or not 1 <= fan_index <= 64 or type(fan_rpm) is not int or not 1000 <= fan_rpm <= 7999:
                raise RuntimeError('Invalid fan index or RPM')
            fans = Hardware().seed_individual(previous_preference, fan_index, fan_rpm)
            preference = {'schema_version': 4, 'mode': 'manual', 'control_mode': 'individual',
                          'rpm': None, 'fans': fans, 'separate_fans': fans,
                          'linked_rpm': previous_preference['linked_rpm'],
                          'owner_uid': uid, 'generation': uuid.uuid4().hex}
        else:
            preference = {'schema_version': 4, 'mode': 'manual', 'control_mode': 'shared',
                          'rpm': int(action), 'fans': [], 'separate_fans': previous_preference['separate_fans'],
                          'linked_rpm': int(action), 'owner_uid': uid, 'generation': uuid.uuid4().hex}
        apply_manual(preference, persist=True)


def reconcile():
    preference, preference_error = load_preference()
    state = load_state()
    event, wake_error = load_wake()
    if wake_error:
        if event is not None and event['generation'] != state['wake_generation']:
            state['wake_generation'] = event['generation']
            save(state)
        if state['mode'] == 'unknown' and clock() < state['retry_at']:
            return
        if state['mode'] != 'auto' or state.get('error') != wake_error:
            reset(wake_error, retry_delay=RETRY_SECONDS)
        return
    if event is not None and event['generation'] != state['wake_generation']:
        if state['inhibited'] and event['created_at'] <= state['sleep_started_at']:
            state['wake_generation'] = event['generation']
            save(state)  # A stale post from an older sleep is retired only.
        else:
            if not sleep_operation_finished():
                # Keep the notification pending across intermediate RTC wakes,
                # ongoing stop jobs, or an unavailable system manager. A pre
                # timeout may have happened before its inhibit was journaled.
                if not state['inhibited']:
                    state['inhibited'] = True
                    save(state)
                if state['mode'] != 'auto' and clock() >= state['retry_at']:
                    reset('Waiting for the outer sleep operation to finish', retry_delay=RETRY_SECONDS)
                return
            state.update(inhibited=False, sleep_started_at=0, mode='unknown', recovering=True,
                         wake_generation=event['generation'])
            save(state)
            if not reset():
                return
        state = load_state()

    if preference_error:
        if state['mode'] == 'unknown' and clock() < state['retry_at']:
            return
        if state['mode'] != 'auto' or state.get('error') != preference_error:
            reset(preference_error, retry_delay=RETRY_SECONDS)
        return
    if state['inhibited']:
        if state['mode'] != 'auto' and clock() >= state['retry_at']:
            reset('Manual setting paused for sleep', retry_delay=RETRY_SECONDS)
        return
    if state['mode'] == 'unknown':
        if clock() < state['retry_at']:
            return
        if not reset('Recovered interrupted control operation'):
            return
        state = load_state()
    if preference['mode'] == 'auto':
        if state['mode'] != 'auto':
            reset()
        return
    if state.get('restore_blocked_generation') == preference['generation']:
        if state['mode'] != 'auto':
            reset(state.get('restore_blocked_reason'), retry_delay=RETRY_SECONDS)
        elif state.get('error') != state.get('restore_blocked_reason'):
            state['error'] = state.get('restore_blocked_reason')
            save(state)
        return
    if state['mode'] == 'auto':
        if clock() < state['retry_at']:
            return
        try:
            hardware = Hardware()
            # Hysteresis: once released, wait until every exposed peripheral is
            # below 75 C before restoring a saved manual setting.
            hardware.check_temperatures(limit=75000)
            apply_manual(preference)
        except (OSError, ValueError, RuntimeError) as exc:
            current = load_state()
            if current['mode'] == 'auto':
                current.update(error='Saved manual target paused: ' + str(exc),
                               retry_at=clock() + RETRY_SECONDS,
                               thermal_paused=isinstance(exc, ThermalFault))
                save(current)
        return
    if not state_matches_preference(state, preference):
        if reset('Reconciling saved fan preference'):
            try:
                apply_manual(preference)
            except RuntimeError:
                pass
        return
    try:
        hardware = Hardware()
        hardware.check_temperatures()
        planned = (hardware.planned_targets(fans=preference['fans'])
                   if preference['control_mode'] == 'individual' else hardware.planned_targets(rpm=preference['rpm']))
        if {item['index']: item['target'] for item in planned} != {item['index']: item['target'] for item in state['targets']}:
            # The durable request remains authoritative if a hardware limit
            # changes. Re-clamp transactionally; never retain an out-of-range
            # cached target or rewrite the user's saved RPM preference.
            try:
                apply_manual(preference)
            except RuntimeError:
                pass
            return
        observed = hardware.observed_targets()
        if not hardware.matches(state['targets'], observed):
            diagnostic = hardware.target_diagnostic(state['targets'], observed)
            repairs = [value for value in state['repairs'] if clock() - value < DRIFT_REPAIR_WINDOW]
            if len(repairs) >= MAX_DRIFT_REPAIRS:
                raise RuntimeError('Manual targets repeatedly overridden after %d repairs in %d seconds: %s'
                                   % (MAX_DRIFT_REPAIRS, DRIFT_REPAIR_WINDOW, diagnostic))
            save({**state, 'mode': 'unknown', 'recovering': True,
                  'error': 'Recovering manual target drift: ' + diagnostic})
            hardware.reacquire(state['targets'])
            hardware.check_temperatures()
            state.update(recovering=False, repairs=repairs + [clock()],
                         error='Recovered manual target drift: ' + diagnostic)
            save(state)
    except (OSError, ValueError, KeyError, TypeError, RuntimeError) as exc:
        reset('Saved manual target paused: ' + str(exc),
              retry_delay=DRIFT_COOLDOWN_SECONDS if 'overridden' in str(exc) else RETRY_SECONDS,
              thermal_paused=isinstance(exc, ThermalFault))


def watchdog_tick():
    with locked():
        reconcile()
        atomic_json(RUNTIME / 'watchdog.json', {'boot_id': boot_id(), 'updated_at': clock()})


def notify_systemd(message):
    # Only the root systemd service uses this. CLI actions never consume it.
    address = os.environ.get('NOTIFY_SOCKET')
    if not address:
        return
    if address.startswith('@'):
        address = '\0' + address[1:]
    with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as connection:
        connection.connect(address)
        connection.sendall(message.encode('ascii'))


def watchdog():
    stopping = False

    def stop(_signum, _frame):
        nonlocal stopping
        stopping = True

    for signum in (signal.SIGTERM, signal.SIGINT):
        signal.signal(signum, stop)
    with locked():
        reset()
    notify_systemd("READY=1")
    try:
        while not stopping:
            watchdog_tick()
            notify_systemd('WATCHDOG=1')
            # Keep signal shutdown responsive without busy polling.
            for _ in range(int(WATCHDOG_INTERVAL * 5)):
                if stopping:
                    break
                time.sleep(0.2)
    finally:
        with locked():
            with contextlib.suppress(FileNotFoundError):
                (RUNTIME / 'watchdog.json').unlink()
            reset()


def main():
    os.umask(0o022)
    if len(sys.argv) < 2:
        raise RuntimeError('Usage: apple-silicon-fan-control <auto|linked|separate|status|heartbeat TOKEN|RPM|fan INDEX RPM>')
    action = sys.argv[1]
    generation = None
    fan_index = fan_rpm = None
    if action == 'fan':
        if (len(sys.argv) != 4 or not re.fullmatch(r'[1-9]|[1-5][0-9]|6[0-4]', sys.argv[2])
                or not re.fullmatch(r'[1-7][0-9]{3}', sys.argv[3])):
            raise RuntimeError('Fan requires an index from 1 to 64 and a four-digit RPM from 1000 to 7999')
        fan_index, fan_rpm = int(sys.argv[2]), int(sys.argv[3])
    elif action == 'heartbeat':
        if len(sys.argv) != 3 or not re.fullmatch(r'[0-9a-f]{32}', sys.argv[2]):
            raise RuntimeError('Heartbeat requires the current 32-character lease generation')
        generation = sys.argv[2]
    elif len(sys.argv) != 2 or not re.fullmatch(r'auto|linked|separate|release|status|watchdog|sleep|resume|wake-signal|sleep-failed|[1-7][0-9]{3}', action):
        raise RuntimeError('Invalid fan broker action')
    if action == 'status':
        print(json.dumps(status(), allow_nan=False, separators=(',', ':')))
        return
    if os.geteuid() != 0:
        raise RuntimeError('Fan changes require the installed root broker')
    if action == 'watchdog':
        watchdog()
    else:
        outcome = command(action, generation, fan_index, fan_rpm)
        result = {'wake_signalled': bool(outcome)} if action in ('wake-signal', 'sleep-failed') else status()
        print(json.dumps(result, allow_nan=False, separators=(',', ':')))


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, TypeError, RuntimeError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
